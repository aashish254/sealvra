#!/usr/bin/env python3
"""Sealvra git credential helper (v0.2, W05).

Speaks git's credential protocol on stdin/stdout: ``get`` / ``store`` /
``erase`` with ``key=value`` lines terminated by a blank line.

Context comes ONLY from wrapper-set environment variables, which live
for the git child process lifetime and are never written to disk:

    KH_GIT_SESSION_TOKEN   session token (kh_sess_...) — the ONLY
                           credential this helper ever returns
    KH_GIT_EXPIRES_AT      session expiry, epoch seconds
    KH_GIT_SCOPE_HOST      allowed host (exact match)
    KH_GIT_SCOPE_REPO      allowed repo (owner/name, exact match)

``get`` returns username ``sealvra`` + the session token, and only
when the requested host/path match the scope exactly and the session
is live. It NEVER returns a real provider key (it never receives one).
``store`` / ``erase`` are deliberate no-ops: a session credential must
never be persisted into a git credential store.

Usage (set by the wrapper, not by hand):
    git -c credential.helper= \
        -c credential.helper=<this script> \
        -c credential.useHttpPath=true push <remote> <refspec>

Exit codes: 0 with a credential block on a successful ``get`` (or on
the store/erase no-ops); 1 with no output when no credential may be
issued. Nothing secret is ever written to stderr.
"""

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from sealvra.git import GitHelperContext, handle_helper


def main(argv: list[str]) -> int:
    if len(argv) != 2 or argv[1] not in ("get", "store", "erase"):
        return 1
    context = GitHelperContext.from_env(os.environ)
    input_text = sys.stdin.read()
    output, exit_code = handle_helper(argv[1], input_text, context)
    if output:
        sys.stdout.write(output)
        sys.stdout.flush()
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
